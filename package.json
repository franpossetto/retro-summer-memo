{
  "name": "retro-summer-memo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:integration": "TEST_SCOPE=integration vitest run",
    "test:mcp": "TEST_SCOPE=mcp vitest run",
    "mcp:build": "vite build --config vite.mcp.config.ts",
    "mcp:serve": "npm run mcp:build && supabase functions serve mcp",
    "mcp:deploy": "npm run mcp:build && supabase functions deploy mcp --no-verify-jwt",
    "db:start": "supabase start -x imgproxy,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@supabase/supabase-js": "^2.119.1",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "supabase": "^3.2.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
