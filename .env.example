# Copy to .env.local. Without these two, data stays in this browser (localStorage).
# Local values come from `npx supabase status -o env` after `npm run db:start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# GitHub / Google sign-in buttons appear by themselves when the provider is enabled in Supabase Auth.

# Local Mailpit inbox for sign-in links while developing.
VITE_DEV_MAILBOX_URL=http://127.0.0.1:54324
